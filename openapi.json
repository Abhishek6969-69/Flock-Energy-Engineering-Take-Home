
{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy Meter API",
    "version": "1.0.0",
    "description": "REST API wrapper around the Urja Meter Ops portal for meter listing, search, details, location, hierarchy, and consumption readings."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "API health check"
    },
    {
      "name": "Meters",
      "description": "Meter listing, details, and consumption"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "message": {
                      "type": "string",
                      "example": "Flock Energy API is running"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "List and search meters",
        "operationId": "getMeters",
        "description": "Returns a paginated list of meters. The optional search query is forwarded to the upstream portal.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Optional meter search query. Maximum 100 characters.",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "example": "J100005"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of meters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterListResponse"
                },
                "example": {
                  "data": [
                    {
                      "meterId": "J100005",
                      "serialNo": "HP63682",
                      "make": "Allied",
                      "phaseType": "three",
                      "installStatus": "Faulty",
                      "dtCode": "DT-006"
                    }
                  ],
                  "total": 1,
                  "page": 1,
                  "pageSize": 20
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamServiceError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/meters/{id}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter details",
        "operationId": "getMeterDetails",
        "description": "Returns meter metadata, geographic location, and hierarchy labels when available.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetails"
                },
                "example": {
                  "meterId": "J100000",
                  "serialNo": "SE33962",
                  "make": "HPL",
                  "phaseType": "single",
                  "installStatus": "Decommissioned",
                  "dtCode": "DT-001",
                  "location": {
                    "latitude": "26.938961002479868",
                    "longitude": "75.83095696146852"
                  },
                  "hierarchy": {
                    "zone": "Jaipur Zone 1 (Z-01)",
                    "circle": "Circle 1 (C-01)",
                    "division": "Division 1 (D-01)",
                    "subdivision": "Subdivision 1 (SD-01)",
                    "substation": "Substation 1 (SS-01)",
                    "feeder": "Feeder 1 (F-001)",
                    "distributionTransformer": "Malviya Nagar DT 1 (DT-001)"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/MeterNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamServiceError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/meters/{id}/consumption": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter consumption readings",
        "operationId": "getMeterConsumption",
        "description": "Returns energy readings for the specified meter. Numeric readings are normalized to numbers when possible.",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption readings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                },
                "example": {
                  "meterId": "J100000",
                  "data": [
                    {
                      "timestamp": "23/06/2026 23:30",
                      "kwh": 48438.74,
                      "kvah": 52313.84,
                      "voltR": 226
                    }
                  ],
                  "total": 337
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamServiceError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MeterId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Meter identifier. The current route validator expects J followed by six digits.",
        "schema": {
          "type": "string",
          "pattern": "^J[0-9]{6}$",
          "example": "J100000"
        }
      }
    },
    "schemas": {
      "Meter": {
        "type": "object",
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "dtCode"
        ],
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        }
      },
      "MeterListResponse": {
        "type": "object",
        "required": ["data", "total", "page", "pageSize"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "Location": {
        "type": "object",
        "nullable": true,
        "properties": {
          "latitude": {
            "type": "string",
            "nullable": true,
            "example": "26.938961002479868"
          },
          "longitude": {
            "type": "string",
            "nullable": true,
            "example": "75.83095696146852"
          }
        }
      },
      "Hierarchy": {
        "type": "object",
        "nullable": true,
        "properties": {
          "zone": {
            "type": "string",
            "nullable": true,
            "example": "Jaipur Zone 1 (Z-01)"
          },
          "circle": {
            "type": "string",
            "nullable": true,
            "example": "Circle 1 (C-01)"
          },
          "division": {
            "type": "string",
            "nullable": true,
            "example": "Division 1 (D-01)"
          },
          "subdivision": {
            "type": "string",
            "nullable": true,
            "example": "Subdivision 1 (SD-01)"
          },
          "substation": {
            "type": "string",
            "nullable": true,
            "example": "Substation 1 (SS-01)"
          },
          "feeder": {
            "type": "string",
            "nullable": true,
            "example": "Feeder 1 (F-001)"
          },
          "distributionTransformer": {
            "type": "string",
            "nullable": true,
            "example": "Malviya Nagar DT 1 (DT-001)"
          }
        }
      },
      "MeterDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Meter"
          },
          {
            "type": "object",
            "required": ["location", "hierarchy"],
            "properties": {
              "location": {
                "$ref": "#/components/schemas/Location"
              },
              "hierarchy": {
                "$ref": "#/components/schemas/Hierarchy"
              }
            }
          }
        ]
      },
      "ConsumptionReading": {
        "type": "object",
        "required": ["timestamp", "kwh", "kvah", "voltR"],
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Timestamp preserved in the upstream DD/MM/YYYY HH:mm format.",
            "example": "23/06/2026 23:30"
          },
          "kwh": {
            "type": "number",
            "nullable": true,
            "example": 48438.74
          },
          "kvah": {
            "type": "number",
            "nullable": true,
            "example": 52313.84
          },
          "voltR": {
            "type": "number",
            "nullable": true,
            "example": 226
          }
        }
      },
      "ConsumptionResponse": {
        "type": "object",
        "required": ["meterId", "data", "total"],
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            }
          },
          "total": {
            "type": "integer",
            "example": 337
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "page must be a positive integer"
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid meter ID or query parameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "VALIDATION_ERROR",
              "message": "Invalid meter ID format. Expected format: J100000"
            }
          }
        }
      },
      "MeterNotFound": {
        "description": "No meter matches the supplied identifier",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "METER_NOT_FOUND",
              "message": "Meter not found"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "INTERNAL_SERVER_ERROR",
              "message": "An unexpected error occurred"
            }
          }
        }
      },
      "UpstreamServiceError": {
        "description": "An upstream service request failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "UPSTREAM_SERVICE_ERROR",
              "message": "Unable to retrieve data from the upstream service"
            }
          }
        }
      },
      "UpstreamTimeout": {
        "description": "The upstream service timed out",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "UPSTREAM_TIMEOUT",
              "message": "The upstream service took too long to respond"
            }
          }
        }
      }
    }
  }
}
